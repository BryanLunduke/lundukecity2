+<?xml version="1.0"?>
+<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
+<!-- Fontconfig setup for the Windows build of Lunduke City 2.
+     Only the fonts shipped in share/fonts are used, so text looks the same
+     as on Linux and the first launch does not scan C:\Windows\Fonts. -->
+<fontconfig>
+  <dir prefix="relative">../../share/fonts</dir>
+
+  <alias binding="same">
+    <family>sans-serif</family>
+    <prefer><family>DejaVu Sans</family></prefer>
+  </alias>
+  <alias binding="same">
+    <family>Sans</family>
+    <prefer><family>DejaVu Sans</family></prefer>
+  </alias>
+  <alias binding="same">
+    <family>monospace</family>
+    <prefer><family>DejaVu Sans Mono</family></prefer>
+  </alias>
+
+  <match target="font">
+    <edit name="antialias" mode="assign"><bool>true</bool></edit>
+    <edit name="hinting" mode="assign"><bool>true</bool></edit>
+    <edit name="hintstyle" mode="assign"><const>hintslight</const></edit>
+    <edit name="rgba" mode="assign"><const>none</const></edit>
+  </match>
+
+  <cachedir>LOCAL_APPDATA_FONTCONFIG_CACHE</cachedir>
+</fontconfig>
diff --git a/packaging/windows/mingw64-sysroot.py b/packaging/windows/mingw64-sysroot.py
new file mode 100755
index 0000000..e2977c6
--- /dev/null
+++ b/packaging/windows/mingw64-sysroot.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Build a MinGW-w64 x86_64 sysroot from signed MSYS2 mingw64 packages.
+
+  mingw64-sysroot.py WORKDIR SYSROOT [package ...]
+
+Downloads the mingw64 repo database and its signature, checks the signature
+with gpg against the MSYS2 keyring, resolves the runtime dependency closure
+of the requested packages, downloads each package, checks its sha256 against
+the signed database, unpacks it under SYSROOT/mingw64, and rewrites the
+pkg-config prefixes to point there.
+
+Needs: python3, gpg, tar with zstd support.
+"""
+import hashlib, json, os, re, subprocess, sys, urllib.request
+
+REPO = 'https://repo.msys2.org/mingw/mingw64/'
+KEYRING = 'https://raw.githubusercontent.com/msys2/MSYS2-keyring/master/'
+SKIP = {'mingw-w64-x86_64-python', 'mingw-w64-x86_64-gcc'}
+DEFAULT = ['sdl3', 'cairo', 'pango', 'ttf-dejavu']
+
+
+def fetch(url, dest):
+    if not os.path.exists(dest):
+        print('fetch', url, flush=True)
+        urllib.request.urlretrieve(url, dest + '.part')
+        os.replace(dest + '.part', dest)
+
+
+def main():
+    work, sysroot = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
+    wanted = sys.argv[3:] or DEFAULT
+    os.makedirs(os.path.join(work, 'pkgs'), exist_ok=True)
+    db, sig = (os.path.join(work, n) for n in ('mingw64.db', 'mingw64.db.sig'))
+    fetch(REPO + 'mingw64.db', db)
+    fetch(REPO + 'mingw64.db.sig', sig)
+    kr = {}
+    for n in ('msys2.gpg', 'msys2-trusted', 'msys2-revoked'):
+        kr[n] = os.path.join(work, n)
+        fetch(KEYRING + n, kr[n])
+
+    # Same trust model as pacman-key --populate msys2: a throwaway local key
+    # lsigns the MSYS2 master keys, which then certify the packager keys.
+    gnupg = os.path.join(work, 'gnupg')
+    os.makedirs(gnupg, mode=0o700, exist_ok=True)
+    g = ['gpg', '--homedir', gnupg, '--batch', '--quiet']
+    run = lambda *a, **k: subprocess.run(g + list(a), check=True, capture_output=True, **k)
+    run('--import', kr['msys2.gpg'])
+    if subprocess.run(g + ['--list-secret-keys'], capture_output=True).stdout.strip() == b'':
+        run('--passphrase', '', '--quick-gen-key', 'lunduke-city-sysroot-verify', 'ed25519', 'sign', 'never')
+    masters = [l.split(':')[0] for l in open(kr['msys2-trusted']).read().split() if l]
+    for fpr in masters:
+        run('--yes', '--quick-lsign-key', fpr)
+    run('--import-ownertrust', kr['msys2-trusted'])
+    run('--check-trustdb')
+    revoked = set(open(kr['msys2-revoked']).read().split())
+    st = subprocess.run(g + ['--status-fd', '1', '--verify', sig, db], capture_output=True, text=True)
+    good = re.search(r'^\[GNUPG:\] VALIDSIG (?:\S+ ){9}(\S+)', st.stdout, re.M)
+    trusted = re.search(r'^\[GNUPG:\] TRUST_(FULLY|ULTIMATE)', st.stdout, re.M)
+    if st.returncode != 0 or not good or not trusted or good.group(1) in revoked:
+        sys.exit('mingw64.db signature is not valid and trusted:\n' + st.stdout + st.stderr)
+    print('mingw64.db signed by', good.group(1), '(trusted via MSYS2 master keys)')
+
+    pk, prov = {}, {}
+    dbdir = os.path.join(work, 'db')
+    os.makedirs(dbdir, exist_ok=True)
+    subprocess.run(['tar', '-C', dbdir, '-xf', db], check=True)  # zstd-compressed
+    for entry in sorted(os.listdir(dbdir)):
+        sec, cur = {}, None
+        for line in open(os.path.join(dbdir, entry, 'desc'), encoding='utf-8').read().splitlines():
+            h = re.match(r'^%(\w+)%$', line)
+            if h:
+                cur = h.group(1); sec[cur] = []
+            elif line and cur:
+                sec[cur].append(line)
+        n = sec['NAME'][0]; pk[n] = sec
+        for p in sec.get('PROVIDES', []):
+            prov.setdefault(re.split('[<>=]', p)[0], n)
+
+    def resolve(dep):
+        b = re.split('[<>=]', dep)[0]
+        return b if b in pk else prov.get(b)
+
+    seen, stack = [], ['mingw-w64-x86_64-' + w for w in wanted]
+    while stack:
+        n = resolve(stack.pop())
+        if n is None or n in seen or n in SKIP:
+            continue
+        seen.append(n)
+        stack += pk[n].get('DEPENDS', [])
+
+    manifest = []
+    for n in sorted(seen):
+        s = pk[n]; fn = s['FILENAME'][0]; path = os.path.join(work, 'pkgs', fn)
+        fetch(REPO + fn, path)
+        digest = hashlib.sha256(open(path, 'rb').read()).hexdigest()
+        if digest != s['SHA256SUM'][0]:
+            sys.exit('sha256 mismatch: ' + fn)
+        os.makedirs(sysroot, exist_ok=True)
+        subprocess.run(['tar', '-C', sysroot, '--exclude=.*', '-xf', path], check=True)
+        manifest.append({'file': fn, 'version': s['VERSION'][0], 'sha256': digest})
+        print('ok', fn)
+
+    prefix = os.path.join(sysroot, 'mingw64')
+    for d in ('lib/pkgconfig', 'share/pkgconfig'):
+        pcdir = os.path.join(prefix, d)
+        for f in os.listdir(pcdir) if os.path.isdir(pcdir) else []:
+            p = os.path.join(pcdir, f)
+            txt = open(p).read()
+            txt = re.sub(r'^prefix=.*$', 'prefix=' + prefix, txt, flags=re.M)
+            open(p, 'w').write(txt)
+    json.dump(manifest, open(os.path.join(sysroot, 'packages.json'), 'w'), indent=1)
+    print(len(manifest), 'packages verified and unpacked into', prefix)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/packaging/windows/package.sh b/packaging/windows/package.sh
new file mode 100755
index 0000000..ca04ed3
--- /dev/null
+++ b/packaging/windows/package.sh
@@ -0,0 +1,79 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Assemble a self-contained Windows x86_64 folder and zip for Lunduke City 2.
+#
+#   packaging/windows/package.sh BUILD_DIR SYSROOT OUT_DIR
+#
+# OUT_DIR/lunduke-city-2/
+#   bin/lunduke-city-2.exe + every DLL it needs (found by walking PE imports)
+#   etc/fonts/fonts.conf    fontconfig setup that only uses share/fonts
+#   share/fonts/            DejaVu Sans / Sans Mono
+#   share/lunduke-city-2/micropolis-assets
+#   share/licenses/         licenses of everything shipped
+# and OUT_DIR/lunduke-city-2-windows-x86_64.zip
+set -eu
+build=$(cd "$1" && pwd); sysroot=$(cd "$2" && pwd)/mingw64; out=$3
+here=$(cd "$(dirname "$0")" && pwd); src=$(cd "$here/../.." && pwd)
+objdump=${OBJDUMP:-x86_64-w64-mingw32-objdump}
+strip=${STRIP:-x86_64-w64-mingw32-strip}
+name=lunduke-city-2
+root=$out/$name
+
+rm -rf "$root"; mkdir -p "$root/bin" "$root/etc/fonts" "$root/share/fonts" \
+  "$root/share/$name" "$root/share/licenses/$name"
+cp "$build/src/$name.exe" "$root/bin/"
+"$strip" --strip-unneeded "$root/bin/$name.exe"
+
+# DLL closure. Anything not in the sysroot must be a Windows system DLL.
+queue="$root/bin/$name.exe"
+while [ -n "$queue" ]; do
+  next=""
+  for f in $queue; do
+    for dll in $("$objdump" -p "$f" | sed -n 's/^[[:space:]]*DLL Name: //p' | tr -d '\r'); do
+      [ -e "$root/bin/$dll" ] && continue
+      if [ -e "$sysroot/bin/$dll" ]; then
+        cp "$sysroot/bin/$dll" "$root/bin/"
+        next="$next $root/bin/$dll"
+      fi
+    done
+  done
+  queue=$next
+done
+for dll in "$root"/bin/*.dll; do "$strip" --strip-unneeded "$dll"; done
+
+cp -r "$src/third_party/micropolis-assets" "$root/share/$name/micropolis-assets"
+cp "$here/fonts.conf" "$root/etc/fonts/fonts.conf"
+for f in DejaVuSans.ttf DejaVuSans-Bold.ttf DejaVuSans-Oblique.ttf DejaVuSans-BoldOblique.ttf \
+         DejaVuSansMono.ttf DejaVuSansMono-Bold.ttf; do
+  cp "$sysroot/share/fonts/TTF/$f" "$root/share/fonts/"
+done
+
+cp "$src/COPYING" "$src/NOTICE" "$src/README.md" "$root/share/licenses/$name/"
+# One license directory per MSYS2 package that contributed a shipped file.
+for pkgdir in "$sysroot/share/licenses"/*; do
+  pkg=$(basename "$pkgdir")
+  case $pkg in python-packaging|tzdata|wineditline|vulkan-loader|lzo2) continue ;; esac
+  cp -r "$pkgdir" "$root/share/licenses/$pkg"
+done
+[ -f "$sysroot/../packages.json" ] && cp "$sysroot/../packages.json" "$root/share/licenses/msys2-packages.json"
+
+cat > "$root/README-windows.txt" <<'TXT'
+Lunduke City 2 for Windows (x86_64)
+
+Run bin\lunduke-city-2.exe. Keep the folder together: the program finds its
+DLLs in bin\, its game data in share\lunduke-city-2\ and its fonts through
+etc\fonts\fonts.conf.
+
+Saves and settings go to %APPDATA%\lunduke-city-2\ (see REPORT for details).
+TXT
+
+(
+  cd "$out" && rm -f "$name-windows-x86_64.zip"
+  if command -v zip >/dev/null 2>&1; then
+    zip -qr9X "$name-windows-x86_64.zip" "$name"
+  else
+    python3 -m zipfile -c "$name-windows-x86_64.zip" "$name"
+  fi
+)
+echo "packaged $root"
+ls -l "$out/$name-windows-x86_64.zip"
