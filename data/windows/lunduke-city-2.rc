// Windows resources for Lunduke City 2: icon, manifest, version info.
#include <windows.h>

1 ICON "lunduke-city-2.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "lunduke-city-2.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "The Lunduke Journal"
      VALUE "FileDescription", "Lunduke City 2"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "lunduke-city-2"
      VALUE "LegalCopyright", "GPL-3.0-or-later. See COPYING and NOTICE."
      VALUE "OriginalFilename", "lunduke-city-2.exe"
      VALUE "ProductName", "Lunduke City 2"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
