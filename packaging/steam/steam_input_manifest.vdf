//
// Steam Input Action Manifest for Lunduke City 2. Steamworks reads it
// from the depot when Steam Input is set to "Custom Configuration
// (Bundled with game)". The game does not use the Steam Input API:
// one legacy action set, and the layouts emulate an Xbox pad. Paths
// are relative to this file. See packaging/steam/README.md.
"Action Manifest"
{
	"configurations"
	{
		"controller_neptune"
		{
			"0"
			{
				"path"		"lunduke_city_2_deck.vdf"
			}
		}
		"controller_steamcontroller_gordon"
		{
			"0"
			{
				"path"		"lunduke_city_2_deck.vdf"
			}
		}
		"controller_xboxone"
		{
			"0"
			{
				"path"		"lunduke_city_2_gamepad.vdf"
			}
		}
		"controller_xbox360"
		{
			"0"
			{
				"path"		"lunduke_city_2_gamepad.vdf"
			}
		}
		"controller_ps4"
		{
			"0"
			{
